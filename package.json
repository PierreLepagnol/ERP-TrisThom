{
  "name": "ERPTrisThom",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "convex": "^1.42.1",
      "better-auth": "1.6.15",
      "@convex-dev/better-auth": "^0.12.5",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "bunx tsc --noEmit -p apps/web/tsconfig.json && bunx tsc --noEmit -p packages/ui/tsconfig.json && bunx tsc --noEmit -p packages/env/tsconfig.json && bunx tsc --noEmit -p packages/backend/convex/tsconfig.json",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F @ERPTrisThom/backend",
    "dev:setup": "turbo run dev:setup -F @ERPTrisThom/backend",
    "crm:import": "bun scripts/import-crm.ts"
  },
  "dependencies": {
    "@ERPTrisThom/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ERPTrisThom/config": "workspace:*",
    "@types/node": "^22.13.14",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.9"
}
